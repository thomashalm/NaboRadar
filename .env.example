# Kopier til .env.local og fyll inn. Commit aldri ekte verdier.

# --- Supabase (hosted) — valgfritt i fase 3 -------------------------------
# Prosjekt → Settings → API. Appen starter og søk fungerer uten disse.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) eller legacy anon key. Trygg å eksponere i nettleseren; RLS beskytter data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) eller legacy service_role. KUN server. Brukes av sync fra fase 4.
SUPABASE_SECRET_KEY=
# Direkte Postgres-tilkobling for migrasjoner og verifisering (npm run db:push / db:verify). KUN lokalt/CI.
# Supabase → Connect → Connection string → Session pooler (port 5432), med database-passordet.
SUPABASE_DB_URL=

# --- Lokal utviklingsdatabase (uten Supabase) --------------------------------
# pglite = Postgres + PostGIS i prosessen (.data/pglite), samme migrasjoner. Aldri i produksjon.
# Ignoreres når Supabase-variablene over er satt.
LOCAL_DATABASE=

# --- Bakgrunnskart — valgfritt ------------------------------------------------
# XYZ-mal med {z}, {x}, {y}. Standard: Kartverket topograatone (WMTS/webmercator).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Tester -------------------------------------------------------------------
# Sett til 1 for å kjøre integrasjonstester mot ekte Kartverket-API.
RUN_NETWORK_TESTS=

# --- Drift: varsling og heartbeat ---------------------------------------------
# Brukes kun av sync-worker og varslingsjobben (npm run alerts:check), aldri av webappen.
# I produksjon ligger disse i GitHub Actions Secrets — ikke i Netlify.
# Uten dem logger varslingen hva den ville sendt, og går OK.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Standard: NaboRadar <alerts@naboradar.no>
ALERT_EMAIL_FROM=
# Standard: https://naboradar.no/admin
ALERT_ADMIN_URL=
